generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum SourceType {
  url
  pdf
  epub
  text
  manual
  book_chapter
}

enum ReadingStatus {
  unread
  reading
  done
  not_now
  archived
}

enum DisplayMode {
  manual
  suggested
}

enum DigestCadence {
  off
  daily
  every_other_day
  weekly
  monthly
  seasonal
}

enum LengthEstimationMethod {
  schema_wordCount
  schema_timeRequired
  schema_articleBody
  readability
  trafilatura
  manual
  unknown
}

enum LengthEstimationConfidence {
  high
  medium
  low
  unknown
}

enum UserStatus {
  active
  deactivated
}

model User {
  id              String       @id @default(cuid())
  email           String       @unique
  displayName     String?
  passwordHash    String
  status          UserStatus   @default(active)
  isAdmin         Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  readingItems    ReadingItem[]
  readEvents      ReadEvent[]
  books           Book[]
  tags            Tag[]
  appSettings     AppSettings?
  createdInvites  Invite[]     @relation("InviteCreatedBy")
  redeemedInvites Invite[]     @relation("InviteRedeemedBy")
  sessions        Session[]
  extensionTokens ExtensionToken[]
  passwordResetTokens PasswordResetToken[]
}

model Invite {
  id               String   @id @default(cuid())
  email            String
  tokenHash        String   @unique
  expiresAt        DateTime
  redeemedAt       DateTime?
  revokedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  createdByUserId  String
  redeemedByUserId  String?
  createdByUser    User     @relation("InviteCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  redeemedByUser   User?    @relation("InviteRedeemedBy", fields: [redeemedByUserId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([expiresAt])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ExtensionToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  name        String
  key         String
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, key, windowStart])
  @@index([name, windowStart])
}

model ReadingItem {
  id                         String                     @id @default(cuid())
  title                      String
  sourceType                 SourceType
  sourceUrl                  String?
  author                     String?
  siteName                   String?
  notes                      String?
  extractedText              String?
  wordCount                  Int?
  estimatedMinutes           Int?
  lengthEstimationMethod     LengthEstimationMethod?
  lengthEstimationConfidence LengthEstimationConfidence?
  priorityScore              Int?
  status                     ReadingStatus              @default(unread)
  manualRank                 Int?
  suggestedRank              Int?
  pinned                     Boolean                    @default(false)
  eddySlot                   Int?
  eddyAddedAt                DateTime?
  userId                     String
  bookId                     String?
  chapterIndex               Int?
  lastOpenedAt               DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  user                       User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  book                       Book?                      @relation(fields: [bookId], references: [id], onDelete: SetNull)
  readEvent                  ReadEvent?
  tags                       ReadingItemTag[]

  @@index([userId])
  @@unique([userId, id])
  @@unique([userId, eddySlot])
  @@index([bookId])
  @@index([status])
}

model ReadEvent {
  id            String      @id @default(cuid())
  readingItemId String      @unique
  userId        String
  readAt        DateTime    @default(now())
  readingItem   ReadingItem @relation(fields: [userId, readingItemId], references: [userId, id], onDelete: Cascade)
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, readingItemId])
  @@index([userId])
  @@index([readAt])
}

model Book {
  id        String        @id @default(cuid())
  title     String
  author    String?
  coverUrl  String?
  notes     String?
  userId    String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ReadingItem[]

  @@index([userId])
}

model Tag {
  id        String           @id @default(cuid())
  name      String
  userId    String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ReadingItemTag[]

  @@unique([userId, name])
  @@index([userId])
}

model ReadingItemTag {
  readingItemId String
  tagId         String
  createdAt     DateTime    @default(now())
  readingItem   ReadingItem @relation(fields: [readingItemId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([readingItemId, tagId])
  @@index([tagId])
}

/// Per-user application settings stored under the owning user id.
model AppSettings {
  id                        String      @id @default(cuid())
  userId                    String      @unique
  displayMode               DisplayMode @default(suggested)
  manualOrderActive         Boolean     @default(false)
  highPriorityThreshold     Int         @default(7)
  shortReadThresholdMinutes Int         @default(25)
  defaultReadingSpeedWpm    Int         @default(200)
  digestCadence             DigestCadence @default(off)
  includeBookRouletteInDigest Boolean   @default(false)
  priorityRandomPoolSize    Int         @default(3)
  lastDigestSentAt          DateTime?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  user                      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NameRankingSubmission {
  id          String   @id @default(cuid())
  voterKey    String   @unique
  voterName   String
  comparisons Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// POps: personal agentic task management (/pops). Single owner, no user FK.
// Every table is prefixed so it cannot collide with Reading River data.
// ---------------------------------------------------------------------------

enum PopsWorkspace {
  learn
  writing
  experiments
  work
}

enum PopsTaskStatus {
  active
  paused
  completed
  archived
}

enum PopsActor {
  human
  agent
  system
}

enum PopsHistoryKind {
  created
  edited
  status_changed
  note
  evidence
  agent_run
  decision_opened
  decision_answered
  feedback
  subtask_added
  link_added
  resurfacing
}

enum PopsRunOutcome {
  completed
  partial
  blocked
  failed
}

enum PopsSubmissionChannel {
  api
  mcp
  import
}

enum PopsDecisionStatus {
  open
  answered
  withdrawn
}

enum PopsProposalKind {
  playbook_observation
  playbook_change
  pipeline_change
  new_pipeline
}

enum PopsProposalStatus {
  pending
  accepted
  rejected
}

model PopsSession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?

  @@index([expiresAt])
}

model PopsAgentCredential {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  scopes      String[]
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
}

model PopsTask {
  id                    String         @id @default(cuid())
  title                 String
  description           String         @default("")
  workspace             PopsWorkspace
  projectTags           String[]       @default([])
  status                PopsTaskStatus @default(active)
  parentId              String?
  parent                PopsTask?      @relation("PopsSubtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks              PopsTask[]     @relation("PopsSubtasks")
  recommendedPipelines  String[]       @default([])
  suggestedNextAction   String         @default("")
  lastHumanEngagementAt DateTime       @default(now())
  resurfaceAfter        DateTime?
  createdBy             PopsActor      @default(human)
  creationKey           String?        @unique
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  completedAt           DateTime?
  archivedAt            DateTime?

  history   PopsHistoryEntry[]
  runs      PopsAgentRun[]
  decisions PopsDecision[]
  linksFrom PopsTaskLink[]     @relation("PopsLinkFrom")
  linksTo   PopsTaskLink[]     @relation("PopsLinkTo")
  proposals PopsProposal[]

  @@index([workspace, status])
  @@index([status, lastHumanEngagementAt])
  @@index([parentId])
}

model PopsTaskLink {
  id         String   @id @default(cuid())
  fromTaskId String
  toTaskId   String
  note       String   @default("")
  createdAt  DateTime @default(now())
  fromTask   PopsTask @relation("PopsLinkFrom", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask     PopsTask @relation("PopsLinkTo", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId])
}

model PopsHistoryEntry {
  id         String          @id @default(cuid())
  taskId     String
  task       PopsTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind       PopsHistoryKind
  actor      PopsActor
  summary    String
  detail     Json?
  runId      String?
  decisionId String?
  dedupeKey  String?         @unique
  createdAt  DateTime        @default(now())

  @@index([taskId, createdAt])
}

model PopsAgentRun {
  id                String                @id @default(cuid())
  taskId            String
  task              PopsTask              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  pipelineSlug      String?
  pipelineVersion   Int?
  idempotencyKey    String                @unique
  contentHash       String
  channel           PopsSubmissionChannel
  credentialId      String?
  agentName         String                @default("")
  outcome           PopsRunOutcome
  attempted         String
  accomplished      String
  sources           Json                  @default("[]")
  artefacts         Json                  @default("[]")
  uncertainties     String                @default("")
  blockers          String                @default("")
  nextActions       Json                  @default("[]")
  pipelineReview    String                @default("")
  createdAt         DateTime              @default(now())
  feedback          PopsRunFeedback?
  decisions         PopsDecision[]

  @@index([taskId, createdAt])
  @@index([pipelineSlug])
}

model PopsRunFeedback {
  id        String       @id @default(cuid())
  runId     String       @unique
  run       PopsAgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  useful    Boolean
  reason    String       @default("")
  comments  String       @default("")
  relayed   Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model PopsDecision {
  id             String             @id @default(cuid())
  taskId         String
  task           PopsTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runId          String?
  run            PopsAgentRun?      @relation(fields: [runId], references: [id], onDelete: SetNull)
  question       String
  recommendation String             @default("")
  options        Json               @default("[]")
  explanation    String             @default("")
  evidence       Json               @default("[]")
  status         PopsDecisionStatus @default(open)
  chosenOption   String             @default("")
  response       String             @default("")
  raisedBy       PopsActor          @default(agent)
  dedupeKey      String?            @unique
  createdAt      DateTime           @default(now())
  answeredAt     DateTime?

  @@index([taskId, status])
}

model PopsPipeline {
  id             String                @id @default(cuid())
  slug           String                @unique
  name           String
  workspace      PopsWorkspace?
  summary        String                @default("")
  currentVersion Int                   @default(1)
  archived       Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  versions       PopsPipelineVersion[]
  proposals      PopsProposal[]
}

model PopsPipelineVersion {
  id           String       @id @default(cuid())
  pipelineId   String
  pipeline     PopsPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  version      Int
  instructions String
  expectedEvidence String   @default("")
  changeNote   String       @default("")
  author       PopsActor    @default(human)
  createdAt    DateTime     @default(now())

  @@unique([pipelineId, version])
}

model PopsPlaybookVersion {
  id         String    @id @default(cuid())
  version    Int       @unique
  content    String
  changeNote String    @default("")
  author     PopsActor @default(human)
  proposalId String?
  createdAt  DateTime  @default(now())
}

model PopsProposal {
  id           String             @id @default(cuid())
  kind         PopsProposalKind
  status       PopsProposalStatus @default(pending)
  pipelineId   String?
  pipeline     PopsPipeline?      @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  taskId       String?
  task         PopsTask?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  runId        String?
  title        String
  body         String
  rationale    String             @default("")
  reviewNote   String             @default("")
  dedupeKey    String?            @unique
  createdAt    DateTime           @default(now())
  reviewedAt   DateTime?

  @@index([status, kind])
}
